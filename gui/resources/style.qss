/* 오목 로봇 GUI 스타일 */
QWidget {
    font-size: 13px;
}
QPushButton {
    padding: 6px 14px;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    background: #f5f5f5;
}
QPushButton:hover {
    background: #e8e8e8;
}
QPushButton:disabled {
    color: #aaa;
    background: #fafafa;
}
QPushButton#startButton {
    background: #2e7d32;
    color: white;
    border: none;
    font-weight: bold;
}
QPushButton#startButton:disabled {
    background: #a5c8a7;
}
QGroupBox {
    font-weight: bold;
    border: 1px solid #ccc;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}
QLabel#stateLabel {
    font-size: 15px;
}
QTextEdit {
    font-family: Consolas, "D2Coding", monospace;
    font-size: 12px;
}
