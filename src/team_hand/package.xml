<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>team_hand</name>
  <version>0.1.0</version>
  <description>오목 로봇 손 감지 노드: /vision/image_raw -> /vision/hand_state</description>
  <maintainer email="team@example.com">team_hand</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>gomoku_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- OpenCV(4.8 이상)는 gomoku 가상환경의 pip 버전을 사용. apt python3-opencv(4.6)를 rosdep 으로 추가 설치하지 않도록 선언하지 않음 -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
